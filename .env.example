# Analytics integrations for Ecomlytics2
# GA4 Measurement ID is public and is used by the browser gtag tag.
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Mixpanel project token (project token, not service-account secret)
MIXPANEL_PROJECT_TOKEN=
# Use https://api.mixpanel.com for US projects or https://api-eu.mixpanel.com for EU projects.
MIXPANEL_HOST=https://api.mixpanel.com

# PostHog project API key (phc_...) and ingestion host for your region.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# Amplitude Project API Key and matching ingestion endpoint.
AMPLITUDE_API_KEY=
AMPLITUDE_INGEST_URL=https://api2.amplitude.com/2/httpapi
